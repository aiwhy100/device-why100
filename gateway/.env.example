# 复制成 .env 再改：cp .env.example .env
# .env 里有 Key，不要提交到 git（.gitignore 已经排除）

# ── 用哪个接口 ──
# app：个人开发者（aiwhy100.com/app 「设置 → API Key」创建 Key；识别直接用 AI为什么100 的，不用自己部署）
# partner：合作厂商（厂商后台创建 Key；识别用自己部署的 asr-server，录音不出你们的服务器）
UPSTREAM=app
AIWHY100_API_KEY=svf_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# kids：给 5–12 岁孩子（约 100 秒，有「你可以试试」小实验）；web：普通（60–90 秒）
CHANNEL=kids

# ── 识别 ──
# 个人开发者留空 = 用 https://api.aiwhy100.com/api/app/v1/asr
# 合作厂商：docker compose --profile asr up -d 会一起启动 asr-server，这里填 http://asr:8090/asr
ASR_URL=
# asr-server 设了 ASR_TOKENS 时填其中一个
ASR_TOKEN=

# ── 安全 ──
# 设备令牌，逗号分隔（每台设备一个，固件里配置成同一个）。网关放到公网上一定要设
DEVICE_TOKENS=
# 家长网页密码（浏览器弹窗，用户名随意）。放到公网上建议设
PARENT_PASSWORD=
# 合作厂商回调签名密钥（厂商后台「接入设置」里的 whsec_…）；回调地址填 https://<网关域名>/webhook/aiwhy100
WEBHOOK_SECRET=

# 查「小奇讲过啦」：同一个问题已经有成片时直接收进账号、不扣额度（只有个人开发者接口有）
MATCH=true
